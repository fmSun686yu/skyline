# ============================================================
# skyline
# .gitignore for mohomo-configs
# Mihomo and Shadowrocket configuration repository
# ============================================================

# Ignore macOS system files
.DS_Store

# Ignore environment variable files
.env

# Local development tools and generated artifacts
.tools/
.dotnet-home/
.nuget/
artifacts/
**/bin/
**/obj/
.vs/
*.user
*.suo

# Private deployment/test inputs; public template YAML remains tracked
private/
**/config.local.yaml
**/config.private.yaml
**/subscription.txt
**/secret.yaml
