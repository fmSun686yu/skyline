<Window x:Class="Skyline.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding ProductName}" Width="900" Height="740" MinWidth="620" MinHeight="520"
        FontFamily="Segoe UI" FontSize="14" Background="#F3F6FA" WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="36,28">
      <TextBlock Text="{Binding Stage}" FontSize="12" FontWeight="SemiBold" Foreground="#3261A8" />
      <TextBlock Text="{Binding ProductName}" Margin="0,12,0,4" FontSize="32" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Subtitle}" FontSize="17" />
      <TextBlock Text="{Binding VersionLabel}" Margin="0,12,0,24" FontSize="12" Foreground="#586B80" />
      <Border Padding="20,16" CornerRadius="10" BorderThickness="1">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="#FFF0EF" />
            <Setter Property="BorderBrush" Value="#E8BBB7" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsReady}" Value="True">
                <Setter Property="Background" Value="#EBF5F0" />
                <Setter Property="BorderBrush" Value="#C1DDD0" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <TextBlock Text="{Binding StatusTitle}" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="{Binding StatusBody}" Margin="0,5,0,0" />
          <TextBlock Text="{Binding Diagnostic}" FontSize="12" />
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding TemplatesHeading}" Margin="0,24,0,12" FontSize="18" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding Templates}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="White" BorderBrush="#DCE3ED" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Version}" Margin="0,3,0,0" Foreground="#3261A8" />
                <TextBlock Text="{Binding Detail}" Margin="0,6,0,10" Foreground="#586B80" />
                <TextBlock Text="{Binding HashLabel}" FontSize="10" Foreground="#586B80" />
                <TextBlock Text="{Binding Hash}" FontFamily="Consolas" FontSize="11" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding BoundaryTitle}" FontWeight="SemiBold" Margin="0,10,0,5" />
      <TextBlock Text="{Binding BoundaryBody}" Foreground="#586B80" />
      <TextBlock Text="{Binding Footer}" Margin="0,22,0,0" FontSize="11" Foreground="#586B80" />
    </StackPanel>
  </ScrollViewer>
</Window>
